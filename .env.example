# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dentaflow?schema=public"

# Auth provider (TBD — NextAuth or similar)
# AUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3100

# OpenAI
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_51TeD2cC67mkvhdN1VFxyynJbW0zxb1TIQ727Mes0jH1NBK6PRNgyFiDLaXM9pvceFxd6p8nmS7vQzoazu4WEn0gH00WCrO1tvI
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51TeD2cC67mkvhdN1bNzaIwQJQA1Dzhk5T4kBZZ41qnlNdrdxbflicCpDsL6v1rk0dhizztm4PZYm7nCwDOFtsMrm00wWtDjuZ2

# Pusher Channels (not Beams). Browser requires NEXT_PUBLIC_* in Next.js.
PUSHER_APP_ID=
PUSHER_SECRET=
# Optional server aliases (used if NEXT_PUBLIC_* are unset on the server):
# PUSHER_KEY=
# PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# UploadThing v7 (dashboard → API Keys → V7 tab). UPLOADTHING_SECRET is v6-only.
# App id is embedded in the token; UPLOADTHING_APP_ID is not required.
UPLOADTHING_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Tenant lifecycle
TENANT_APPROVAL_REQUIRED=false
SUPER_ADMIN_CLERK_USER_IDS=user_xxxxxxxx

# Email (MailHog in Docker dev — http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="DentaFlow <no-reply@dentaflow.local>"
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_PASS=          (alias for SMTP_PASSWORD)
# SMTP_SECURE=false
