# Docker dev environment variables
#
# This file is loaded by docker-compose.dev.yml via env_file: .env.docker
# Do not commit secrets in real projects; keep this for local dev only.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Tenant lifecycle
TENANT_APPROVAL_REQUIRED=false
SUPER_ADMIN_AUTH_USER_IDS=auth_superadmin
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Postgres (inside docker network)
DATABASE_URL=postgresql://dentaflow:dentaflow@db:5432/dentaflow?schema=public

# NextAuth
AUTH_SECRET=dev-change-me-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI
OPENAI_API_KEY=

# Stripe (test keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Pusher (optional for realtime)
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# MailHog (SMTP)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM="DentaFlow <no-reply@dentaflow.local>"

# MinIO (S3-compatible local storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=dentaflow
MINIO_REGION=us-east-1

# Redis (optional)
REDIS_URL=redis://redis:6379

