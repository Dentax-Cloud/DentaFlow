generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  EXPIRED
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum UserRole {
  ADMIN
  OWNER
  DOCTOR
  DENTIST
  HYGIENIST
  RECEPTIONIST
  MANAGER
  FINANCE
  ACCOUNTANT
  STORE
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  IN_CHAIR
  COMPLETED
  CANCELED
  NO_SHOW
}

enum ToothNotation {
  FDI
  UNIVERSAL
}

enum ToothConditionType {
  HEALTHY
  CARIES
  RESTORATION
  CROWN
  IMPLANT
  MISSING
  PERIO_POCKET
  MOBILITY
  FRACTURE
  ROOT_CANAL
}

enum TreatmentPlanStatus {
  DRAFT
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  DECLINED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  STRIPE
  INSURANCE
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DENIED
  PAID
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum CampaignChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELED
}

enum StockTransactionType {
  PURCHASE
  USAGE
  ADJUSTMENT
  EXPIRED
  RETURN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  EXPORT
  PERMISSION_CHANGE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

// ─── Tenant & Auth ───────────────────────────────────────────────────────────

model Tenant {
  id                   String             @id @default(cuid())
  clerkOrgId           String             @unique
  name                 String
  slug                 String             @unique
  status               TenantStatus       @default(PENDING)
  email                String?
  phone                String?
  address              String?
  city                 String?
  country              String?
  timezone             String             @default("UTC")
  locale               String             @default("en")
  logoUrl              String?
  subscriptionPlan     SubscriptionPlan   @default(STARTER)
  subscriptionStatus   SubscriptionStatus   @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  featureFlags         Json?
  metadata             Json?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  onboardingCompleted  Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?

  approvalRequests     TenantApprovalRequest[]
  branches           Branch[]
  users              User[]
  roles              Role[]
  patients           Patient[]
  chairs             Chair[]
  doctors            Doctor[]
  appointments       Appointment[]
  treatmentPlans     TreatmentPlan[]
  teeth              Tooth[]
  toothConditions    ToothCondition[]
  invoices           Invoice[]
  payments           Payment[]
  insurancePolicies  InsurancePolicy[]
  claims             Claim[]
  leads              Lead[]
  campaigns          Campaign[]
  communicationLogs  CommunicationLog[]
  feedbacks          Feedback[]
  inventoryItems     InventoryItem[]
  stockTransactions  StockTransaction[]
  suppliers          Supplier[]
  procedures         ProcedureCatalog[]
  auditLogs          AuditLog[]
  settings           Settings?
  attachments        Attachment[]
  clinicalNotes      ClinicalNote[]
  recalls            Recall[]
}

model TenantApprovalRequest {
  id          String         @id @default(cuid())
  tenantId    String
  requestedBy String
  status      ApprovalStatus @default(PENDING)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

model Branch {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chairs       Chair[]
  appointments Appointment[]

  @@index([tenantId])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  clerkUserId  String
  email        String
  firstName    String?
  lastName     String?
  avatarUrl    String?
  role         UserRole  @default(RECEPTIONIST)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor            Doctor?
  appointments      Appointment[]  @relation("AssignedProvider")
  clinicalNotes     ClinicalNote[]
  auditLogs         AuditLog[]
  userPermissions   UserPermission[]

  @@unique([tenantId, clerkUserId])
  @@index([tenantId])
  @@index([clerkUserId])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  module      String
  createdAt   DateTime @default(now())

  roles RolePermission[]
  users UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  tenantId     String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([tenantId])
}

model UserPermission {
  userId       String
  permissionId String
  tenantId     String
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([tenantId])
}

// ─── Patients ──────────────────────────────────────────────────────────────────

model Patient {
  id              String    @id @default(cuid())
  tenantId        String
  patientNumber   String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  dateOfBirth     DateTime?
  gender          String?
  address         String?
  city            String?
  emergencyContact String?
  emergencyPhone  String?
  medicalHistory  Json?
  dentalHistory   Json?
  allergies       String[]
  medications     String[]
  notes           String?
  portalUserId    String?
  churnRisk       RiskLevel?
  noShowRisk      RiskLevel?
  lastVisitAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  treatmentPlans    TreatmentPlan[]
  teeth             Tooth[]
  toothConditions   ToothCondition[]
  invoices          Invoice[]
  insurancePolicies InsurancePolicy[]
  attachments       Attachment[]
  clinicalNotes     ClinicalNote[]
  communicationLogs CommunicationLog[]
  feedbacks         Feedback[]
  recalls           Recall[]

  @@unique([tenantId, patientNumber])
  @@index([tenantId])
  @@index([tenantId, lastName, firstName])
}

model Attachment {
  id          String   @id @default(cuid())
  tenantId    String
  patientId   String?
  name        String
  type        String
  url         String
  size        Int?
  mimeType    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id])

  @@index([tenantId])
  @@index([tenantId, patientId])
}

// ─── Clinical Staff & Chairs ───────────────────────────────────────────────────

model Doctor {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String   @unique
  specialty    String?
  licenseNo    String?
  color        String   @default("#0ea5e9")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]
  chairs       Chair[]

  @@index([tenantId])
}

model Chair {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  number    Int
  doctorId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id])
  doctor       Doctor?       @relation(fields: [doctorId], references: [id])
  appointments Appointment[]

  @@unique([tenantId, branchId, number])
  @@index([tenantId])
}

// ─── Appointments ──────────────────────────────────────────────────────────────

model Appointment {
  id              String            @id @default(cuid())
  tenantId        String
  patientId       String
  doctorId        String?
  chairId         String?
  branchId        String?
  providerId      String?
  title           String
  startTime       DateTime
  endTime         DateTime
  status          AppointmentStatus @default(SCHEDULED)
  type            String?
  notes           String?
  reminderSent    Boolean           @default(false)
  noShowRisk      RiskLevel?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id])
  doctor   Doctor?  @relation(fields: [doctorId], references: [id])
  chair    Chair?   @relation(fields: [chairId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])
  provider User?    @relation("AssignedProvider", fields: [providerId], references: [id])

  @@index([tenantId])
  @@index([tenantId, startTime])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
}

// ─── Dental Charting ───────────────────────────────────────────────────────────

model Tooth {
  id         String        @id @default(cuid())
  tenantId   String
  patientId  String
  number     String
  notation   ToothNotation @default(FDI)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient    Patient          @relation(fields: [patientId], references: [id])
  conditions ToothCondition[]

  @@unique([tenantId, patientId, number])
  @@index([tenantId, patientId])
}

model ToothCondition {
  id          String             @id @default(cuid())
  tenantId    String
  patientId   String
  toothId     String
  type        ToothConditionType
  surfaces    String[]
  severity    Int?
  mobility    Int?
  pocketDepth Float?
  notes       String?
  recordedAt  DateTime           @default(now())
  recordedBy  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id])
  tooth   Tooth   @relation(fields: [toothId], references: [id])

  @@index([tenantId, patientId])
  @@index([tenantId, toothId])
}

model ClinicalNote {
  id          String   @id @default(cuid())
  tenantId    String
  patientId   String
  providerId  String
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  rawNotes    String?
  aiGenerated Boolean  @default(false)
  visitDate   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient  Patient @relation(fields: [patientId], references: [id])
  provider User    @relation(fields: [providerId], references: [id])

  @@index([tenantId, patientId])
}

// ─── Treatment Planning ────────────────────────────────────────────────────────

model TreatmentPlan {
  id          String              @id @default(cuid())
  tenantId    String
  patientId   String
  title       String
  description String?
  status      TreatmentPlanStatus @default(DRAFT)
  phase       Int                 @default(1)
  totalCost   Decimal             @default(0) @db.Decimal(12, 2)
  acceptedAt  DateTime?
  aiSuggested Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient         @relation(fields: [patientId], references: [id])
  items   TreatmentItem[]

  @@index([tenantId, patientId])
}

model TreatmentItem {
  id              String   @id @default(cuid())
  tenantId        String
  treatmentPlanId String
  procedureCode   String?
  description     String
  toothNumbers    String[]
  quantity        Int      @default(1)
  unitCost        Decimal  @db.Decimal(12, 2)
  totalCost       Decimal  @db.Decimal(12, 2)
  phase           Int      @default(1)
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  treatmentPlan TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  @@index([tenantId, treatmentPlanId])
}

// ─── Billing ───────────────────────────────────────────────────────────────────

model ProcedureCatalog {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  category    String?
  price       Decimal  @db.Decimal(12, 2)
  duration    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  patientId     String
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  dueDate       DateTime?
  notes         String?
  stripePaymentIntentId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient  Patient       @relation(fields: [patientId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  tenantId    String
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  procedureCode String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
}

model Payment {
  id              String        @id @default(cuid())
  tenantId        String
  invoiceId       String
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  reference       String?
  stripePaymentId String?
  paidAt          DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([tenantId, invoiceId])
}

model InsurancePolicy {
  id             String    @id @default(cuid())
  tenantId       String
  patientId      String
  provider       String
  policyNumber   String
  groupNumber    String?
  coveragePercent Float?
  annualMax      Decimal?  @db.Decimal(12, 2)
  validFrom      DateTime?
  validTo        DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id])
  claims  Claim[]

  @@index([tenantId, patientId])
}

model Claim {
  id          String      @id @default(cuid())
  tenantId    String
  policyId    String
  invoiceId   String?
  claimNumber String?
  amount      Decimal     @db.Decimal(12, 2)
  status      ClaimStatus @default(DRAFT)
  submittedAt DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy InsurancePolicy @relation(fields: [policyId], references: [id])

  @@index([tenantId])
}

// ─── CRM & Marketing ───────────────────────────────────────────────────────────

model Lead {
  id        String     @id @default(cuid())
  tenantId  String
  firstName String
  lastName  String?
  email     String?
  phone     String?
  source    String?
  status    LeadStatus @default(NEW)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
}

model Campaign {
  id        String          @id @default(cuid())
  tenantId  String
  name      String
  channel   CampaignChannel
  status    CampaignStatus  @default(DRAFT)
  subject   String?
  body      String
  scheduledAt DateTime?
  sentCount Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CommunicationLog {
  id        String          @id @default(cuid())
  tenantId  String
  patientId String?
  channel   CampaignChannel
  direction String          @default("outbound")
  subject   String?
  body      String
  status    String          @default("sent")
  sentAt    DateTime        @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id])

  @@index([tenantId])
}

model Feedback {
  id        String   @id @default(cuid())
  tenantId  String
  patientId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId])
}

model Recall {
  id          String    @id @default(cuid())
  tenantId    String
  patientId   String
  type        String
  dueDate     DateTime
  priority    Int       @default(0)
  churnRisk   RiskLevel?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, dueDate])
  @@index([tenantId, patientId])
}

// ─── Inventory ─────────────────────────────────────────────────────────────────

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  InventoryItem[]

  @@index([tenantId])
}

model InventoryItem {
  id           String    @id @default(cuid())
  tenantId     String
  supplierId   String?
  sku          String
  name         String
  category     String?
  unit         String    @default("unit")
  quantity     Int       @default(0)
  reorderLevel Int       @default(10)
  cost         Decimal?  @db.Decimal(12, 2)
  batchNumber  String?
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier     Supplier?          @relation(fields: [supplierId], references: [id])
  transactions StockTransaction[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model StockTransaction {
  id        String               @id @default(cuid())
  tenantId  String
  itemId    String
  type      StockTransactionType
  quantity  Int
  notes     String?
  createdAt DateTime             @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   InventoryItem @relation(fields: [itemId], references: [id])

  @@index([tenantId, itemId])
}

// ─── Settings & Audit ──────────────────────────────────────────────────────────

model Settings {
  id                    String  @id @default(cuid())
  tenantId              String  @unique
  defaultNotation       ToothNotation @default(FDI)
  appointmentDuration   Int     @default(30)
  reminderHoursBefore   Int     @default(24)
  currency              String  @default("USD")
  taxRate               Float   @default(0)
  enablePatientPortal   Boolean @default(true)
  enableOnlinePayments  Boolean @default(true)
  smsProvider           String?
  whatsappProvider      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String
  userId     String?
  action     AuditAction
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity])
}
