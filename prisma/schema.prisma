generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String                  @id @default(cuid())
  clerkOrgId           String?                 @unique
  name                 String
  slug                 String                  @unique
  email                String?
  phone                String?
  address              String?
  city                 String?
  country              String?
  timezone             String                  @default("UTC")
  logoUrl              String?
  subscriptionPlan     SubscriptionPlan        @default(STARTER)
  subscriptionStatus   SubscriptionStatus      @default(TRIALING)
  stripeCustomerId     String?                 @unique
  stripeSubscriptionId String?                 @unique
  onboardingCompleted  Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deletedAt            DateTime?
  status               TenantStatus            @default(PENDING)
  locale               String                  @default("en")
  featureFlags         Json?
  metadata             Json?
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  appointments         Appointment[]
  attachments          Attachment[]
  auditLogs            AuditLog[]
  branches             Branch[]
  campaigns            Campaign[]
  chairs               Chair[]
  claims               Claim[]
  clinicalNotes        ClinicalNote[]
  communicationLogs    CommunicationLog[]
  doctors              Doctor[]
  feedbacks            Feedback[]
  insurancePolicies    InsurancePolicy[]
  inventoryItems       InventoryItem[]
  invoices             Invoice[]
  leads                Lead[]
  patients             Patient[]
  payments             Payment[]
  procedures           ProcedureCatalog[]
  recalls              Recall[]
  roles                Role[]
  settings             Settings?
  stockTransactions    StockTransaction[]
  suppliers            Supplier[]
  approvalRequests     TenantApprovalRequest[]
  teeth                Tooth[]
  toothConditions      ToothCondition[]
  treatmentPlans       TreatmentPlan[]
  staffMembers         StaffMember[]
  tenant_memberships   tenant_memberships[]
}

model TenantApprovalRequest {
  id          String         @id @default(cuid())
  tenantId    String
  requestedBy String
  status      ApprovalStatus @default(PENDING)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

model Branch {
  id           String        @id @default(cuid())
  tenantId     String
  name         String
  address      String?
  phone        String?
  isPrimary    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  appointments Appointment[]
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chairs       Chair[]

  @@index([tenantId])
}

model StaffMember {
  id              String           @id @default(cuid())
  tenantId        String
  clerkUserId     String?
  email           String
  firstName       String?
  lastName        String?
  avatarUrl       String?
  role            UserRole         @default(RECEPTIONIST)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  authUserId      String?
  appointments    Appointment[]    @relation("AssignedProvider")
  auditLogs       AuditLog[]
  clinicalNotes   ClinicalNote[]
  doctor          Doctor?
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userPermissions UserPermission[]

  @@unique([tenantId, clerkUserId])
  @@index([tenantId])
  @@index([clerkUserId])
  @@map("User")
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  module      String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
  users       UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  tenantId     String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([tenantId])
}

model UserPermission {
  userId       String
  permissionId String
  tenantId     String
  granted      Boolean     @default(true)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         StaffMember @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([tenantId])
}

model Patient {
  id                String             @id @default(cuid())
  tenantId          String
  patientNumber     String
  firstName         String
  lastName          String
  email             String?
  phone             String?
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  city              String?
  emergencyContact  String?
  emergencyPhone    String?
  medicalHistory    Json?
  dentalHistory     Json?
  allergies         String[]
  medications       String[]
  notes             String?
  portalUserId      String?
  churnRisk         RiskLevel?
  noShowRisk        RiskLevel?
  lastVisitAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  appointments      Appointment[]
  attachments       Attachment[]
  clinicalNotes     ClinicalNote[]
  communicationLogs CommunicationLog[]
  feedbacks         Feedback[]
  insurancePolicies InsurancePolicy[]
  invoices          Invoice[]
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recalls           Recall[]
  teeth             Tooth[]
  toothConditions   ToothCondition[]
  treatmentPlans    TreatmentPlan[]

  @@unique([tenantId, patientNumber])
  @@index([tenantId])
  @@index([tenantId, lastName, firstName])
}

model Attachment {
  id          String    @id @default(cuid())
  tenantId    String
  patientId   String?
  name        String
  type        String
  url         String
  size        Int?
  mimeType    String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  patient     Patient?  @relation(fields: [patientId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, patientId])
}

model Doctor {
  id           String        @id @default(cuid())
  tenantId     String
  userId       String        @unique
  specialty    String?
  licenseNo    String?
  color        String        @default("#0ea5e9")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  chairs       Chair[]
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         StaffMember   @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model Chair {
  id           String        @id @default(cuid())
  tenantId     String
  branchId     String
  name         String
  number       Int
  doctorId     String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  branch       Branch        @relation(fields: [branchId], references: [id])
  doctor       Doctor?       @relation(fields: [doctorId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, number])
  @@index([tenantId])
}

model Appointment {
  id           String            @id @default(cuid())
  tenantId     String
  patientId    String
  doctorId     String?
  chairId      String?
  branchId     String?
  providerId   String?
  title        String
  startTime    DateTime
  endTime      DateTime
  status       AppointmentStatus @default(SCHEDULED)
  type         String?
  notes        String?
  reminderSent Boolean           @default(false)
  noShowRisk   RiskLevel?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  branch       Branch?           @relation(fields: [branchId], references: [id])
  chair        Chair?            @relation(fields: [chairId], references: [id])
  doctor       Doctor?           @relation(fields: [doctorId], references: [id])
  patient      Patient           @relation(fields: [patientId], references: [id])
  provider     StaffMember?      @relation("AssignedProvider", fields: [providerId], references: [id])
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, startTime])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
}

model Tooth {
  id         String           @id @default(cuid())
  tenantId   String
  patientId  String
  number     String
  notation   ToothNotation    @default(FDI)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  patient    Patient          @relation(fields: [patientId], references: [id])
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conditions ToothCondition[]

  @@unique([tenantId, patientId, number])
  @@index([tenantId, patientId])
}

model ToothCondition {
  id          String             @id @default(cuid())
  tenantId    String
  patientId   String
  toothId     String
  type        ToothConditionType
  surfaces    String[]
  severity    Int?
  mobility    Int?
  pocketDepth Float?
  notes       String?
  recordedAt  DateTime           @default(now())
  recordedBy  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  patient     Patient            @relation(fields: [patientId], references: [id])
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tooth       Tooth              @relation(fields: [toothId], references: [id])

  @@index([tenantId, patientId])
  @@index([tenantId, toothId])
}

model ClinicalNote {
  id          String      @id @default(cuid())
  tenantId    String
  patientId   String
  providerId  String
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  rawNotes    String?
  aiGenerated Boolean     @default(false)
  visitDate   DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  patient     Patient     @relation(fields: [patientId], references: [id])
  provider    StaffMember @relation(fields: [providerId], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
}

model TreatmentPlan {
  id          String              @id @default(cuid())
  tenantId    String
  patientId   String
  title       String
  description String?
  status      TreatmentPlanStatus @default(DRAFT)
  phase       Int                 @default(1)
  totalCost   Decimal             @default(0) @db.Decimal(12, 2)
  acceptedAt  DateTime?
  aiSuggested Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  items       TreatmentItem[]
  patient     Patient             @relation(fields: [patientId], references: [id])
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
}

model TreatmentItem {
  id              String        @id @default(cuid())
  tenantId        String
  treatmentPlanId String
  procedureCode   String?
  description     String
  toothNumbers    String[]
  quantity        Int           @default(1)
  unitCost        Decimal       @db.Decimal(12, 2)
  totalCost       Decimal       @db.Decimal(12, 2)
  phase           Int           @default(1)
  status          String        @default("pending")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  @@index([tenantId, treatmentPlanId])
}

model ProcedureCatalog {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  category    String?
  price       Decimal  @db.Decimal(12, 2)
  duration    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Invoice {
  id                    String        @id @default(cuid())
  tenantId              String
  patientId             String
  invoiceNumber         String
  status                InvoiceStatus @default(DRAFT)
  subtotal              Decimal       @default(0) @db.Decimal(12, 2)
  tax                   Decimal       @default(0) @db.Decimal(12, 2)
  discount              Decimal       @default(0) @db.Decimal(12, 2)
  total                 Decimal       @default(0) @db.Decimal(12, 2)
  dueDate               DateTime?
  notes                 String?
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?
  patient               Patient       @relation(fields: [patientId], references: [id])
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items                 InvoiceItem[]
  payments              Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
}

model InvoiceItem {
  id            String  @id @default(cuid())
  tenantId      String
  invoiceId     String
  description   String
  quantity      Int     @default(1)
  unitPrice     Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  procedureCode String?
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
}

model Payment {
  id              String        @id @default(cuid())
  tenantId        String
  invoiceId       String
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  reference       String?
  stripePaymentId String?
  paidAt          DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, invoiceId])
}

model InsurancePolicy {
  id              String    @id @default(cuid())
  tenantId        String
  patientId       String
  provider        String
  policyNumber    String
  groupNumber     String?
  coveragePercent Float?
  annualMax       Decimal?  @db.Decimal(12, 2)
  validFrom       DateTime?
  validTo         DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  claims          Claim[]
  patient         Patient   @relation(fields: [patientId], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
}

model Claim {
  id          String          @id @default(cuid())
  tenantId    String
  policyId    String
  invoiceId   String?
  claimNumber String?
  amount      Decimal         @db.Decimal(12, 2)
  status      ClaimStatus     @default(DRAFT)
  submittedAt DateTime?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  policy      InsurancePolicy @relation(fields: [policyId], references: [id])
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Lead {
  id        String     @id @default(cuid())
  tenantId  String
  firstName String
  lastName  String?
  email     String?
  phone     String?
  source    String?
  status    LeadStatus @default(NEW)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
}

model Campaign {
  id          String          @id @default(cuid())
  tenantId    String
  name        String
  channel     CampaignChannel
  status      CampaignStatus  @default(DRAFT)
  subject     String?
  body        String
  scheduledAt DateTime?
  sentCount   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CommunicationLog {
  id        String          @id @default(cuid())
  tenantId  String
  patientId String?
  channel   CampaignChannel
  direction String          @default("outbound")
  subject   String?
  body      String
  status    String          @default("sent")
  sentAt    DateTime        @default(now())
  patient   Patient?        @relation(fields: [patientId], references: [id])
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Feedback {
  id        String   @id @default(cuid())
  tenantId  String
  patientId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Recall {
  id          String     @id @default(cuid())
  tenantId    String
  patientId   String
  type        String
  dueDate     DateTime
  priority    Int        @default(0)
  churnRisk   RiskLevel?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  patient     Patient    @relation(fields: [patientId], references: [id])
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, dueDate])
  @@index([tenantId, patientId])
}

model Supplier {
  id        String          @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     InventoryItem[]
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model InventoryItem {
  id           String             @id @default(cuid())
  tenantId     String
  supplierId   String?
  sku          String
  name         String
  category     String?
  unit         String             @default("unit")
  quantity     Int                @default(0)
  reorderLevel Int                @default(10)
  cost         Decimal?           @db.Decimal(12, 2)
  batchNumber  String?
  expiryDate   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  supplier     Supplier?          @relation(fields: [supplierId], references: [id])
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions StockTransaction[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model StockTransaction {
  id        String               @id @default(cuid())
  tenantId  String
  itemId    String
  type      StockTransactionType
  quantity  Int
  notes     String?
  createdAt DateTime             @default(now())
  item      InventoryItem        @relation(fields: [itemId], references: [id])
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, itemId])
}

model Settings {
  id                   String        @id @default(cuid())
  tenantId             String        @unique
  defaultNotation      ToothNotation @default(FDI)
  appointmentDuration  Int           @default(30)
  reminderHoursBefore  Int           @default(24)
  currency             String        @default("USD")
  taxRate              Float         @default(0)
  enablePatientPortal  Boolean       @default(true)
  enableOnlinePayments Boolean       @default(true)
  smsProvider          String?
  whatsappProvider     String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String       @id @default(cuid())
  tenantId  String
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime     @default(now())
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      StaffMember? @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity])
}

model auth_users {
  id                 String               @id
  name               String?
  email              String               @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  isSuperAdmin       Boolean              @default(false)
  activeTenantId     String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  tenant_memberships tenant_memberships[]
}

model tenant_memberships {
  id           String     @id
  userId       String
  tenantId     String
  role         String     @default("MEMBER")
  isActive     Boolean    @default(true)
  invitedEmail String?
  acceptedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now())
  Tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tm_tenant_fk")
  auth_users   auth_users @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tm_user_fk")

  @@unique([userId, tenantId], map: "tm_user_tenant_key")
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  EXPIRED
}

enum UserRole {
  OWNER
  DENTIST
  HYGIENIST
  RECEPTIONIST
  MANAGER
  ACCOUNTANT
  ADMIN
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  IN_CHAIR
  COMPLETED
  CANCELED
  NO_SHOW
}

enum ToothNotation {
  FDI
  UNIVERSAL
}

enum ToothConditionType {
  HEALTHY
  CARIES
  RESTORATION
  CROWN
  IMPLANT
  MISSING
  PERIO_POCKET
  MOBILITY
  FRACTURE
  ROOT_CANAL
}

enum TreatmentPlanStatus {
  DRAFT
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  DECLINED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  STRIPE
  INSURANCE
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DENIED
  PAID
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum CampaignChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELED
}

enum StockTransactionType {
  PURCHASE
  USAGE
  ADJUSTMENT
  EXPIRED
  RETURN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  EXPORT
  PERMISSION_CHANGE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}
