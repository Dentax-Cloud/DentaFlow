model GlobalProcedure {
  id                   String   @id @default(cuid())
  gpmrCode             String   @unique
  canonicalName        String
  names                Json     @default("{}")
  category             String
  subCategory          String?
  clinicalDescription  String?
  defaultDurationMins  Int      @default(30)
  toothRequired        Boolean  @default(false)
  surfaceRequired      Boolean  @default(false)
  archRequired         Boolean  @default(false)
  quadrantRequired     Boolean  @default(false)
  requiredInputs       Json     @default("[]")
  optionalInputs       Json     @default("[]")
  prerequisites        Json     @default("[]")
  contraindications    Json     @default("[]")
  postProcedureActions Json     @default("[]")
  requiredAttachments  Json     @default("[]")
  optionalAttachments  Json     @default("[]")
  globalCodes          Json     @default("{}")
  modules              Json     @default("[]")
  isBillable           Boolean  @default(true)
  canBundle            Boolean  @default(true)
  aiSuggestTriggers    Json     @default("[]")
