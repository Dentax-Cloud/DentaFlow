generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String                  @id @default(cuid())
  name                 String
  slug                 String                  @unique
  email                String?
  phone                String?
  address              String?
  city                 String?
  country              String?
  timezone             String                  @default("UTC")
  logoUrl              String?
  subscriptionPlan     SubscriptionPlan        @default(STARTER)
  subscriptionStatus   SubscriptionStatus      @default(TRIALING)
  stripeCustomerId     String?                 @unique
  stripeSubscriptionId String?                 @unique
  onboardingCompleted  Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deletedAt            DateTime?
  status               TenantStatus            @default(PENDING)
  locale               String                  @default("en")
  featureFlags         Json?
  metadata             Json?
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  suspendedAt          DateTime?
  suspendedReason      String?
  tenantCode           String?
  countryCode          String                  @default("AE")
  globalTenantId       String?
  patientIdDisplayMode String                  @default("FULL")
  appointments         Appointment[]
  attachments          Attachment[]
  auditLogs            AuditLog[]
  branches             Branch[]
  campaigns            Campaign[]
  chairs               Chair[]
  claims               Claim[]
  clinicalNotes        ClinicalNote[]
  clinicalTemplates    ClinicalTemplate[]
  communicationLogs    CommunicationLog[]
  doctors              Doctor[]
  feedbacks            Feedback[]
  patientInsurancePolicies  PatientInsurancePolicy[]
  inventoryItems       InventoryItem[]
  invoices             Invoice[]
  leads                Lead[]
  patients             Patient[]
  payments             Payment[]
  procedures           ProcedureCatalog[]
  recalls              Recall[]
  roles                Role[]
  settings             Settings?
  stockTransactions    StockTransaction[]
  suppliers            Supplier[]
  approvalRequests     TenantApprovalRequest[]
  teeth                Tooth[]
  toothConditions      ToothCondition[]
  treatmentPlans       TreatmentPlan[]
  treatmentEstimates   TreatmentEstimate[]
  preAuthorizations    PreAuthorization[]
  clinicalNoteVersions ClinicalNoteVersion[]
  perioCharts          PerioChart[]
  chairsideSessions    ChairsideSession[]
  chairsideEntries     ChairsideEntry[]
  chairsideEntryVersions ChairsideEntryVersion[]
  toothConditionVersions ToothConditionVersion[]
  treatmentPlanShares  TreatmentPlanShare[]
  clinicalImages       ClinicalImage[]
  photoSeries          PhotoSeries[]
  casePresentations    CasePresentation[]
  emergencyIntakes     EmergencyIntake[]
  staffMembers         StaffMember[]
  tenant_memberships   tenant_memberships[]
  dailyCounters        DailyCounter[]
  barcodeScans         BarcodeScan[]
  supplierBarcodes     SupplierBarcode[]
  inventoryBatches     InventoryBatch[]
  purchaseOrders       PurchaseOrder[]
  posSessions          PosSession[]
  chairSetups          ChairSetup[]
  chairTrayTemplates   ChairTrayTemplate[]
  doctorChairSchedules DoctorChairSchedule[]
  daySessions          DaySession[]
  chairDaySetups       ChairDaySetup[]
  importBatches        ImportBatch[]
  paymentPlans         PaymentPlan[]
  portalAccounts       PatientPortalAccount[]
  bookingRequests      BookingRequest[]
  doctorSchedules      DoctorSchedule[]
  scheduleExceptions   DoctorScheduleException[]
  portalEnabled        Boolean                 @default(false)
  bookingEnabled       Boolean                 @default(false)
  autoConfirmBooking   Boolean                 @default(false)
  bookingLeadHours     Int                     @default(24)
  bookingMaxDays       Int                     @default(60)
  bookingBufferMins    Int                     @default(15)
  portalWelcomeMsg     String?
  portalLogoUrl        String?
  currency             String                  @default("AED")
  currencySymbol       String                  @default("AED")
  taxName              String                  @default("VAT")
  taxRate              Decimal                 @default(5) @db.Decimal(5, 2)
  taxNumber            String?
  taxOnDental          Boolean                 @default(true)
  regulatoryBody       String?
  toothNumbering       String                  @default("FDI")
  defaultLanguage      String                  @default("en")
  secondaryLanguage    String?
  dateFormat           String                  @default("DD/MM/YYYY")
  workingDays          String                  @default("MON,TUE,WED,THU,FRI")
  primaryCodeSystem    String                  @default("ICD10")
  insuranceMandatory   Boolean                 @default(false)
  hipaaRequired        Boolean                 @default(false)
  patientRetentionYrs  Int                     @default(10)
  customFields         TenantCustomField[]
  insuranceProviders   TenantInsuranceProvider[]
  feeSchedules         InsuranceFeeSchedule[]
  membershipPlans      MembershipPlan[]
  corporateAccounts    CorporateAccount[]
  paymentMethods       TenantPaymentMethod[]
  referralContacts     ReferralContact[]
  patientMemberships   PatientMembership[]
  notifications        Notification[]
  procedureBundles      ProcedureBundle[]
  complianceRecords     ClinicalComplianceRecord[]
}

model TenantApprovalRequest {
  id          String         @id @default(cuid())
  tenantId    String
  requestedBy String
  status      ApprovalStatus @default(PENDING)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

model Branch {
  id                String        @id @default(cuid())
  tenantId          String
  name              String
  address           String?
  phone             String?
  isPrimary         Boolean       @default(false)
  branchCode        String?
  cityCode          String        @default("OTH")
  branchSeq         Int           @default(1)
  countryCode       String        @default("AE")
  patientSeqCounter Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  appointments      Appointment[]
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chairs            Chair[]

  @@index([tenantId])
}

model StaffMember {
  id                     String           @id @default(cuid())
  tenantId               String
  email                  String
  firstName              String?
  lastName               String?
  phone                  String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  addressLine1           String?
  city                   String?
  country                String?
  licenseNumber          String?
  avatarUrl              String?
  role                   UserRole         @default(RECEPTIONIST)
  staffRef               String?
  roleCode               String?
  isActive               Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  deletedAt              DateTime?
  authUserId             String?
  appointments    Appointment[]    @relation("AssignedProvider")
  auditLogs       AuditLog[]
  clinicalNotes   ClinicalNote[]
  doctor          Doctor?
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userPermissions UserPermission[]

  @@index([tenantId])
  @@index([authUserId])
  @@map("User")
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  module      String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
  users       UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  tenantId     String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([tenantId])
}

model UserPermission {
  userId       String
  permissionId String
  tenantId     String
  granted      Boolean     @default(true)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         StaffMember @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([tenantId])
}

model Patient {
  id                    String             @id @default(cuid())
  tenantId              String
  patientNumber         String
  patientId             String?
  branchCode            String?
  branchSeq             Int?
  photoUrl              String?
  bloodGroup            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  referredBy            String?
  referralSource        String?
  firstName         String
  lastName          String
  email             String?
  phone             String?
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  city              String?
  emergencyContact  String?
  emergencyPhone    String?
  medicalHistory    Json?
  dentalHistory     Json?
  allergies         String[]
  medications       String[]
  notes             String?
  portalUserId      String?
  churnRisk         RiskLevel?
  noShowRisk        RiskLevel?
  lastVisitAt       DateTime?
  noShowCount       Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  appointments      Appointment[]
  attachments       Attachment[]
  clinicalNotes     ClinicalNote[]
  communicationLogs CommunicationLog[]
  feedbacks         Feedback[]
  patientInsurancePolicies PatientInsurancePolicy[]
  invoices                 Invoice[]
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recalls           Recall[]
  teeth             Tooth[]
  toothConditions   ToothCondition[]
  treatmentPlans    TreatmentPlan[]
  treatmentEstimates TreatmentEstimate[]
  perioCharts       PerioChart[]
  chairsideSessions ChairsideSession[]
  clinicalImages    ClinicalImage[]
  photoSeries       PhotoSeries[]
  casePresentations CasePresentation[]
  emergencyIntakes  EmergencyIntake[]
  paymentPlans      PaymentPlan[]
  portalAccount     PatientPortalAccount?
  bookingRequests   BookingRequest[]
  countryCode           String?
  idDocumentType        String?
  idDocumentNumber      String?
  idDocumentExpiry      DateTime?
  id2DocumentType       String?
  id2DocumentNumber     String?
  fatherName            String?
  grandfatherName       String?
  nationality           String?
  maritalStatus         String?
  occupation            String?
  employer              String?
  insuranceProvider     String?
  insuranceNetwork      String?
  insurancePolicyNo     String?
  insuranceMemberId     String?
  insuranceExpiry       DateTime?
  insuranceCoPayPercent Decimal?              @db.Decimal(5, 2)
  regulatoryPatientId   String?
  corporateAccountId    String?
  customFieldValues     PatientCustomFieldValue[]
  memberships           PatientMembership[]
  corporateAccount      CorporateAccount?     @relation(fields: [corporateAccountId], references: [id], onDelete: SetNull)

  @@unique([tenantId, patientNumber])
  @@index([tenantId])
  @@index([tenantId, lastName, firstName])
  @@index([patientId])
  @@index([branchCode])
  @@index([idDocumentNumber])
  @@index([insuranceProvider])
}

model Attachment {
  id          String    @id @default(cuid())
  tenantId    String
  patientId   String?
  name        String
  type        String
  url         String
  size        Int?
  mimeType    String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  patient     Patient?  @relation(fields: [patientId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, patientId])
}

model Doctor {
  id           String        @id @default(cuid())
  tenantId     String
  userId       String        @unique
  specialty    String?
  licenseNo    String?
  color        String        @default("#0ea5e9")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  chairs       Chair[]
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         StaffMember   @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model Chair {
  id           String        @id @default(cuid())
  tenantId     String
  branchId     String
  name         String
  number       Int
  doctorId     String?
  chairType    String        @default("GENERAL")
  roomName     String?
  equipment    Json?
  colorCode    String        @default("#0ea5e9")
  status       String        @default("ACTIVE")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  branch       Branch        @relation(fields: [branchId], references: [id])
  doctor       Doctor?               @relation(fields: [doctorId], references: [id])
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedules    DoctorChairSchedule[]
  daySetups    ChairDaySetup[]

  @@unique([tenantId, branchId, number])
  @@index([tenantId])
}

model Appointment {
  id           String            @id @default(cuid())
  tenantId     String
  patientId    String?
  doctorId     String?
  chairId      String?
  branchId     String?
  providerId   String?
  title        String
  startTime    DateTime
  endTime      DateTime
  status       AppointmentStatus @default(SCHEDULED)
  isBlock      Boolean           @default(false)
  type         String?
  notes        String?
  reminderSent Boolean           @default(false)
  noShowRisk     RiskLevel?
  appointmentRef       String?
  procedureId          String?
  bookedById           String?
  bookedVia            String?           @default("RECEPTION")
  preAuthStatus        String?           @default("NOT_REQUIRED")
  preAuthCode          String?
  cancellationReason   String?
  cancelledById        String?
  createdAt            DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  branch         Branch?           @relation(fields: [branchId], references: [id])
  chair        Chair?            @relation(fields: [chairId], references: [id])
  doctor       Doctor?           @relation(fields: [doctorId], references: [id])
  patient      Patient?          @relation(fields: [patientId], references: [id])
  provider     StaffMember?      @relation("AssignedProvider", fields: [providerId], references: [id])
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicalNotes ClinicalNote[]

  @@index([tenantId])
  @@index([tenantId, startTime])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
}

model Tooth {
  id         String           @id @default(cuid())
  tenantId   String
  patientId  String
  number     String
  notation   ToothNotation    @default(FDI)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  patient    Patient          @relation(fields: [patientId], references: [id])
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conditions ToothCondition[]

  @@unique([tenantId, patientId, number])
  @@index([tenantId, patientId])
}

model ToothCondition {
  id            String                  @id @default(cuid())
  tenantId      String
  patientId     String
  toothId       String
  type          ToothConditionType
  surfaces      String[]
  severity      Int?
  mobility      Int?
  pocketDepth   Float?
  notes         String?
  appointmentId String?
  recordedAt    DateTime                @default(now())
  recordedBy    String?
  lockedAt      DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  patient       Patient                 @relation(fields: [patientId], references: [id])
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tooth         Tooth                   @relation(fields: [toothId], references: [id])
  versions      ToothConditionVersion[]

  @@index([tenantId, patientId])
  @@index([tenantId, toothId])
  @@index([tenantId, appointmentId])
}

model ToothConditionVersion {
  id            String             @id @default(cuid())
  conditionId   String
  tenantId      String
  version       Int
  type          ToothConditionType
  surfaces      String[]
  severity      Int?
  mobility      Int?
  pocketDepth   Float?
  notes         String?
  amendedById   String?
  amendedByName String?
  amendReason   String?
  createdAt     DateTime           @default(now())
  condition     ToothCondition     @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([conditionId])
  @@index([tenantId])
}

model ClinicalNote {
  id             String                @id @default(cuid())
  tenantId       String
  patientId      String
  providerId     String
  appointmentId  String?
  templateId     String?
  noteType       String                @default("SOAP")
  title          String?
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  bodyHtml       String?
  rawNotes       String?
  toothNumbers   String[]
  aiGenerated    Boolean               @default(false)
  aiEnhanced     Boolean               @default(false)
  currentVersion Int                   @default(1)
  signedAt       DateTime?
  signedByName   String?
  visitDate      DateTime              @default(now())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  patient        Patient               @relation(fields: [patientId], references: [id])
  provider       StaffMember           @relation(fields: [providerId], references: [id])
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment    Appointment?          @relation(fields: [appointmentId], references: [id])
  template       ClinicalTemplate?     @relation(fields: [templateId], references: [id])
  versions       ClinicalNoteVersion[]

  @@index([tenantId, patientId])
  @@index([tenantId, appointmentId])
}

model ClinicalNoteVersion {
  id           String       @id @default(cuid())
  tenantId     String
  noteId       String
  version      Int
  subjective   String?
  objective    String?
  assessment   String?
  plan         String?
  bodyHtml     String?
  rawNotes     String?
  editedById   String?
  editedByName String?
  createdAt    DateTime     @default(now())
  note         ClinicalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([noteId, version])
  @@index([tenantId, noteId])
}

model ClinicalTemplate {
  id        String         @id @default(cuid())
  tenantId  String?
  name      String
  type      String
  content   String
  isDefault Boolean        @default(false)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  tenant    Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notes     ClinicalNote[]

  @@index([tenantId, type])
}

model PerioChart {
  id           String   @id @default(cuid())
  tenantId     String
  patientId    String
  examinerId   String?
  chartDate    DateTime @default(now())
  perioStage   String?
  perioGrade   String?
  bopPercent   Float?
  notes        String?
  measurements Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, patientId])
}

model ChairsideSession {
  id                String           @id @default(cuid())
  tenantId          String
  patientId         String
  appointmentId     String?
  staffId           String?
  startedAt         DateTime         @default(now())
  finalizedAt       DateTime?
  status            String           @default("ACTIVE")
  closedReason      String?
  notes             String?
  noTreatmentReason String?
  invoiceId         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  entries           ChairsideEntry[]

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, appointmentId])
}

model ChairsideEntry {
  id               String                  @id @default(cuid())
  sessionId        String
  tenantId         String
  toothNumber      Int?
  surface          String?
  procedureCode    String?
  procedureName    String?
  conditionType    String?
  notes            String?
  unitPrice        Decimal?                @db.Decimal(10, 2)
  quantity         Int                     @default(1)
  includeInInvoice Boolean                 @default(true)
  lockedAt         DateTime?
  createdAt        DateTime                @default(now())
  session          ChairsideSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions         ChairsideEntryVersion[]

  @@index([sessionId])
  @@index([tenantId])
}

model ChairsideEntryVersion {
  id               String         @id @default(cuid())
  entryId          String
  tenantId         String
  version          Int
  toothNumber      Int?
  surface          String?
  procedureCode    String?
  procedureName    String?
  conditionType    String?
  notes            String?
  unitPrice        Decimal?       @db.Decimal(10, 2)
  quantity         Int
  includeInInvoice Boolean
  amendedById      String?
  amendedByName    String?
  amendReason      String?
  createdAt        DateTime       @default(now())
  entry            ChairsideEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([tenantId])
}

model TreatmentPlan {
  id                String              @id @default(cuid())
  tenantId          String
  patientId         String
  title             String
  description       String?
  status            TreatmentPlanStatus @default(DRAFT)
  phase             Int                 @default(1)
  totalCost         Decimal             @default(0) @db.Decimal(12, 2)
  version           Int                 @default(1)
  parentPlanId      String?
  acceptedAt        DateTime?
  acceptedBy        String?
  rejectedAt        DateTime?
  rejectedReason    String?
  presentedAt       DateTime?
  totalEstimate     Decimal?            @db.Decimal(10, 2)
  insuranceEstimate Decimal?            @db.Decimal(10, 2)
  patientEstimate   Decimal?            @db.Decimal(10, 2)
  aiSuggested       Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  items             TreatmentItem[]
  shares            TreatmentPlanShare[]
  estimates         TreatmentEstimate[]
  patient           Patient             @relation(fields: [patientId], references: [id])
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentPlan        TreatmentPlan?      @relation("PlanRevisions", fields: [parentPlanId], references: [id])
  revisions         TreatmentPlan[]     @relation("PlanRevisions")

  @@index([tenantId, patientId])
  @@index([tenantId, parentPlanId])
}

model TreatmentItem {
  id                  String        @id @default(cuid())
  tenantId            String
  treatmentPlanId     String
  procedureCode       String?
  procedureCatalogId  String?
  description         String
  toothNumbers        String[]
  surfaces            String?
  quantity            Int           @default(1)
  unitCost            Decimal       @db.Decimal(12, 2)
  totalCost           Decimal       @db.Decimal(12, 2)
  phase               Int           @default(1)
  visitNumber         Int           @default(1)
  priority            String        @default("ELECTIVE")
  estimatedDuration   Int?
  status              String        @default("pending")
  completedAt         DateTime?
  completedByStaffId  String?
  linkedAppointmentId String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  treatmentPlan       TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  @@index([tenantId, treatmentPlanId])
  @@index([tenantId, visitNumber])
}

model TreatmentPlanShare {
  id         String        @id @default(cuid())
  planId     String
  tenantId   String
  token      String        @unique
  expiresAt  DateTime
  viewedAt   DateTime?
  acceptedAt DateTime?
  createdAt  DateTime      @default(now())
  plan       TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([token])
}

model ClinicalImage {
  id              String    @id @default(cuid())
  tenantId        String
  patientId       String
  uploadedById    String?
  type            String    @default("XRAY")
  subtype         String?
  url             String
  thumbnailUrl    String?
  fileName        String?
  fileSize        Int?
  mimeType        String?
  width           Int?
  height          Int?
  toothNumbers    String?
  quadrant        String?
  notes           String?
  annotations     Json?
  takenAt         DateTime?
  appointmentId   String?
  treatmentPlanId String?
  photoSeriesId   String?
  photoCategory   String?
  isBeforePhoto   Boolean   @default(false)
  afterImageId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

