# Copy to .env.production on VPS — never commit secrets
DATABASE_URL=postgresql://dentaflow:CHANGE_ME@db:5432/dentaflow?schema=public
NEXT_PUBLIC_APP_URL=https://your-domain.com
NODE_ENV=production

# NextAuth
AUTH_SECRET=
NEXTAUTH_URL=https://your-domain.com
SUPER_ADMIN_AUTH_USER_IDS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OpenAI
OPENAI_API_KEY=

# Pusher
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# UploadThing
UPLOADTHING_TOKEN=

# Tenant lifecycle
TENANT_APPROVAL_REQUIRED=false
SUPER_ADMIN_AUTH_USER_IDS=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM="DentaFlow <no-reply@your-domain.com>"
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
