# Copy to .env.production on VPS — never commit secrets
# Host is dentaflow-db (dev stack container name) — prod joins the same Docker network.
DATABASE_URL=postgresql://dentaflow:dentaflow@dentaflow-db:5432/dentaflow?schema=public
NEXT_PUBLIC_APP_URL=https://dentax.cloud
NODE_ENV=production

# NextAuth
AUTH_SECRET=
# MUST match dev .env.docker when sharing the same database (see scripts/sync-encryption-env.sh)
SETTINGS_ENCRYPTION_KEY=
NEXTAUTH_URL=https://dentax.cloud
SUPER_ADMIN_AUTH_USER_IDS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OpenAI
OPENAI_API_KEY=

# Pusher
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# UploadThing
UPLOADTHING_TOKEN=
# Optional override if callback URL inference fails behind nginx (defaults to NEXTAUTH_URL/api/uploadthing)
# UPLOADTHING_CALLBACK_URL=https://dentax.cloud/api/uploadthing

# Tenant lifecycle
TENANT_APPROVAL_REQUIRED=false
SUPER_ADMIN_AUTH_USER_IDS=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM="DentaFlow <no-reply@dentax.cloud>"
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
