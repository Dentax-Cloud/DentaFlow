# Development Dockerfile (hot reload + Prisma)
#
# - Node 20 Alpine
# - pnpm for package management
# - POSIX sh only (no bash dependency)
# - OpenSSL + postgresql-client for Prisma and wait-for-db
#
# At runtime, docker-compose bind-mounts the repo to /app (live source sync).
# node_modules and .next use named volumes — see docker-compose.dev.yml.

FROM node:20-alpine

RUN apk add --no-cache \
  openssl \
  libc6-compat \
  postgresql-client \
  curl

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

RUN chmod +x scripts/*.sh

EXPOSE 3000

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV CHOKIDAR_USEPOLLING=1
ENV WATCHPACK_POLLING=true

CMD ["/bin/sh", "/app/scripts/entrypoint-web.sh"]
